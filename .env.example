MONGODB_URI=mongodb://127.0.0.1:27017/residency?replicaSet=rs0&directConnection=true
PORT=4000
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Set true only behind your single trusted reverse proxy.
TRUST_PROXY=false
# Optional browser push. Run npm run push:keys once and keep the private key secret.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Additional trusted browser push service hostnames, comma separated; no wildcards.
PUSH_ALLOWED_HOSTS=
# Used once by npm run setup. Supply a different long password per cohort.
# SETUP_ADMINS_JSON=[{"department":"PMR","year":1,"username":"pmr-year1-admin","name":"PM&R Year 1 Admin","password":"replace-with-a-long-unique-password"}]

# Optional persistent demo setting for a custom MongoDB installation.
# Windows installations in PATH or Program Files are detected automatically.
# MONGOMS_SYSTEM_BINARY=C:/Program Files/MongoDB/Server/8.3/bin/mongod.exe
# MONGOMS_RUNTIME_DOWNLOAD=false
